<?xml version="1.0" encoding="UTF-8"?>
<Inspector xmlns:p="http://www.openflexo.org/pamela/" id="0"
	p:modelEntity="org.openflexo.gina.utils.FIBInspector" borderLeft="0"
	sizeAdjustment="OriginalSize"
	controllerClassName="org.openflexo.fml.controller.FMLFIBInspectorController"
	borderRight="0" border="empty" trackViewPortWidth="true"
	font="SansSerif,0,12"
	align="left" borderBottom="0" titleFont="SansSerif,0,12" borderTop="0"
	trackViewPortHeight="true" layout="border" name="Inspector">
	<Parameter id="1" name="title" value="OPC node" />
	<TabPanel id="2" name="Tab" constraints="border(location=center)">
		<Tab id="3" verticalScrollbarPolicy="VERTICAL_SCROLLBAR_AS_NEEDED"
			borderLeft="0" sizeAdjustment="OriginalSize" border="empty"
			borderRight="0" trackViewPortWidth="true" index="0"
			font="SansSerif,0,11"
			align="left" borderBottom="0" titleFont="SansSerif,0,11"
			borderTop="0"
			trackViewPortHeight="true"
			horizontalScrollbarPolicy="HORIZONTAL_SCROLLBAR_AS_NEEDED"
			useScrollBar="true" title="Basic" layout="twocols" name="BasicTab">
			<Label label="name" index="2"
				constraints="twocols(expandHorizontally=false;expandVertically=false;index=2;location=left)"
				name="nameLabel" localize="true" />
			<TextField index="3" data="data.name"
				constraints="twocols(expandHorizontally=true;expandVertically=false;index=3;location=right)"
				name="nameTF" readOnly="true" localize="true" columns="10" />
			<Label label="id" index="4"
				constraints="twocols(expandHorizontally=false;expandVertically=false;index=2;location=left)"
				name="idLabel" localize="true" />
			<TextField index="5" data="data.identifierString"
				constraints="twocols(expandHorizontally=true;expandVertically=false;index=3;location=right)"
				name="idTF" readOnly="true" localize="true" columns="10" />
			<Label label="qualified_name" index="6"
				constraints="twocols(expandHorizontally=false;expandVertically=false;index=2;location=left)"
				name="qnLabel" localize="true" />
			<TextField index="7" data="data.qualifiedName"
				constraints="twocols(expandHorizontally=true;expandVertically=false;index=3;location=right)"
				name="qnTF" readOnly="true" localize="true" columns="10" />
		</Tab>
	</TabPanel>
	<FIBVariable id="13" name="data"
		type="org.openflexo.ta.opcua.model.nodes.OPCNode" />
	<LocalizedDictionary id="14">
		<Localized id="15" value="Avancé" lang="French" key="Advanced" />
		<Localized id="16" value="Basique" lang="French" key="Basic" />
	</LocalizedDictionary>
</Inspector>
